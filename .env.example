# Story Engine 环境变量配置
# 复制为 .env 后填入实际值即可

# ==============================
# GM 与叙述器（SimulationControl + NarrativeRenderer）
# ==============================
# 通用 key：GM 和叙述器都会使用。模型和地址见 src/config/config.yaml（默认 DeepSeek）。
OPENAI_API_KEY=

# 如需分开配置，下面的优先级高于 OPENAI_API_KEY：
# GM_API_KEY=
# GM_MODEL=deepseek/deepseek-chat
# GM_MODEL_BASE_URL=https://api.deepseek.com
# NARRATOR_API_KEY=                 # 不设则回退到 GM_API_KEY
# NARRATOR_MODEL=
# NARRATOR_MODEL_BASE_URL=

# ==============================
# Hermes 角色代理（每个 NPC 的"大脑"）
# ==============================
# Docker 和 local 传输都会读取这些变量。
IKUN_API_KEY=
# HERMES_MODEL=deepseek/deepseek-chat
# HERMES_BASE_URL=https://api.deepseek.com
# HERMES_PROVIDER=                  # 留空则自动检测
